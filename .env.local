################################################################################
# Claude Code (source fork) —— 本地开发环境变量
#
# 加载机制：
#   - bun 启动时自动读取 cwd 下的 .env.local；经 claude/claude-yolo 包装脚本
#     也可以在任意目录继承此处设置（包装脚本内 source 了 model-config/claude-code-env.sh）。
#   - 条目值里的空白会被当作字符串的一部分，所以不要加空格；不要写引号。
#   - 所有 DISABLE_* / CLAUDE_CODE_DISABLE_* 类开关都用 "1" 或 "true" 表示开启。
#
# 图例：
#   ✅ 可开：本 fork 源码完整，打开即用
#   ⚠ 慎用：需要额外条件（Chrome 扩展、订阅等），或会改变安全模型
#   ❌ 禁开：缺文件 / stub，开了启动就 crash（仅作提示，保持注释状态）
################################################################################


# ============================================================================
# [1] API 代理：Claude Code ↔ LiteLLM ↔ 百炼
# ============================================================================
# Anthropic SDK 会在 BASE 后追加 /v1/messages，所以 BASE 只写根即可；
# 写成 http://127.0.0.1:4000/anthropic 会被 LiteLLM 当 passthrough 转发到
# 真·Anthropic，假 token 401（之前踩过的坑）。
ANTHROPIC_BASE_URL=http://127.0.0.1:4000
ANTHROPIC_AUTH_TOKEN=sk-litellm-local-dev


# ============================================================================
# [2] 实用功能开关（✅ 建议默认打开）
# ============================================================================

# Agent Teams：允许 CC 启动多 agent 并行协作（spawn 子 agent 处理子任务）。
# 对外部用户需要此开关 + GrowthBook 放行；本地 dev 配此变量即可生效。
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Task 工具组（TaskCreate / Get / Update / List）：非交互会话里也强制开启，
# 让 headless / -p 模式也能用 Todo 工具做计划追踪。
CLAUDE_CODE_ENABLE_TASKS=1

# LSP 工具：语言服务器查询（跳转定义、引用、类型）。
# dev-with-all-features.ts 默认也会注入 true，这里显式写一遍方便直接 bun 跑时生效。
ENABLE_LSP_TOOL=true

# MCP 大输出文件落盘：MCP 工具返回超长内容时写入文件而不是塞 context，
# 避免 qwen3.6-plus 的 1M 上下文被一次塞爆。
ENABLE_MCP_LARGE_OUTPUT_FILES=1


# ============================================================================
# [3] 电脑 / 浏览器控制 —— 「内部模式」最接近的可用版本
# ============================================================================
# 本 fork 里"内部模式"（USER_TYPE=ant）**不可用**：会在 tools.ts / commands.ts
# 顶部 require 时直接挂（缺 REPLTool、SuggestBackgroundPRTool、agents-platform
# 三个主模块）。电脑控制现实能用的是下面这两套：
#
#   (a) Claude-in-Chrome (CFC) —— ✅ 源码完整，需要装 Chrome 扩展
#       官方扩展页：chrome://extensions → 搜 "Claude Code" 安装，然后握手。
#       打开后 CC 侧会自动注册 mcp__claude-in-chrome__* 一组浏览器控制工具
#       （打开/关闭标签、点击、输入、读屏等），等价于"电脑控制"的子集。
#
#   (b) Computer Use（CHICAGO_MCP）—— ✅ **本 fork 已完整处理**
#       README 明确写明："computer-use-input / computer-use-swift 在 macOS
#       (arm64+x64) 均 ✅ 完整可用"。预编译 .node 文件是从官方发行二进制通过
#       Mach-O 解析直接提取出来的，位置：
#         deps/@ant/computer-use-input/prebuilds/{arm64,x64}-darwin/computer-use-input.node
#         deps/@ant/computer-use-swift/prebuilds/{arm64,x64}-darwin/computer_use.node
#       feature('CHICAGO_MCP') 在 scripts/dev-with-all-features.ts 里也没被
#       排除，默认就是开的。
#
#       唯一的坑：src/utils/computerUse/gates.ts 的 getChicagoEnabled() 有
#       两道运行时门禁——要求 Max/Pro 订阅（走 LiteLLM 代理没法满足）+
#       GrowthBook 的 tengu_malort_pedway.enabled（外部默认 false）。
#       我们在 gates.ts 里补了一个本地逃生舱环境变量，置 1 即可绕过：
CLAUDE_CODE_FORCE_CHICAGO_MCP=1
#       生效后会自动往 MCP 配置里注册 mcp__computer-use__{screenshot,click,
#       type,key,scroll,request_access,...}。首次调用会触发 macOS 请求「屏幕
#       录制 / 辅助功能 / 输入监控」三项 TCC 授权，系统设置里同意一次后常驻。
#
# 下面这一行开 CFC（Claude-in-Chrome）；没装扩展时 CC 会跳过，不影响启动。
CLAUDE_CODE_ENABLE_CFC=1


# ============================================================================
# [4] 关闭后端不支持的高级特性，减少 LiteLLM drop_params 吞参噪声
# ============================================================================
# 百炼 OpenAI 兼容端点不认 Anthropic 的 thinking / interleaved thinking 字段；
# CC 主循环会尝试发 thinking、LiteLLM drop_params=true 会吞掉，功能等于关，
# 但每次都会在日志打一条 "Dropping unknown parameter"。显式关掉更干净。
DISABLE_INTERLEAVED_THINKING=1

# 关闭 auto-compact（对话到阈值自动压缩）。qwen3.6-plus 本身 1M context，
# 大多数日常对话压不压无所谓；如果你喜欢让 CC 自动压缩释放 token，注释掉即可。
#DISABLE_AUTO_COMPACT=1

# 关闭自动 memory 读写（CLAUDE.md 等）。保留它能让 CC 学习你的项目习惯，
# 不喜欢被写就取消注释。
#CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# 关闭后台任务（Bash 的 & 后台执行、AgentTool 的并发子任务等）。
# 默认不开启关闭，保持 CC 能并发执行长任务。
#CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1


# ============================================================================
# [5] 配置目录与沙盒
# ============================================================================
# 这两个变量由包装脚本 ~/.local/bin/claude 在运行时自动导出，此处列出仅做说明：
#   CLAUDE_CONFIG_DIR=$HOME/.claude          —— 全局配置/会话/信任目录
#   CLAUDE_CODE_DEV_CONFIG_DIR=...           —— dev 模式覆盖目录
#
# 如果你把 CC 跑在容器/沙盒里并想放开 --dangerously-skip-permissions 的额外限制，
# 才需要下面两项；普通本地开发不要开。
#IS_SANDBOX=1
#CLAUDE_CODE_BUBBLEWRAP=1


# ============================================================================
# [6] ❌ 本 fork 下不要打开（会在启动时 crash）
# ============================================================================
# 列在这里是为了提醒自己「别手抖打开」，全部保持注释。要开需要先补齐源文件：
#
# USER_TYPE=ant
#   → src/tools.ts 会 require 三个不存在的模块：
#     - ./tools/REPLTool/REPLTool.js
#     - ./tools/SuggestBackgroundPRTool/SuggestBackgroundPRTool.js
#     - ./commands/agents-platform/index.js
#   「内部模式」的完整形态在此 snapshot 被移除了，不可恢复。
#
# CLAUDE_CODE_VERIFY_PLAN=true
#   → require('./tools/VerifyPlanExecutionTool/VerifyPlanExecutionTool.js')
#     但目录里只有 constants.ts，主工具文件缺失。
#
# 想额外启用 bundle feature 需改 scripts/dev-with-all-features.ts 的
# FORK_EXCLUDED_FEATURES 列表；当前所有排除项都因为对应 src 主模块缺失
# （CONTEXT_COLLAPSE / HISTORY_SNIP / WEB_BROWSER_TOOL / TERMINAL_PANEL /
# TORCH / UDS_INBOX / KAIROS* / REVIEW_ARTIFACT / RUN_SKILL_GENERATOR /
# WORKFLOW_SCRIPTS / DAEMON / PROACTIVE / CACHED_MICROCOMPACT）。
